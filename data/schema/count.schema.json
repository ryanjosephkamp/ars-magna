{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ars-magna.pages.dev/schema/count.schema.json",
  "title": "A day's counts of promotions and votes",
  "description": "data/counts/<date>/: promotions.jsonl (one line per promoted anagram whose words are all in the site's vocabulary, under its code), votes.jsonl (one line per hit with votes) and meta.json. Written by the Export promotions Action, one folder a day, never squashed. Nothing a reader typed is in them.",
  "$defs": {
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_sha256",
        "count"
      ],
      "properties": {
        "key_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The SHA-256 of the promotion key, as lowercase hex: the code an anagram is published under in place of its words."
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "vote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hit_id",
        "count"
      ],
      "properties": {
        "hit_id": {
          "type": "string",
          "pattern": "^[a-z]+:(people|companies|products|titles|places|phrases):[a-z]+(-[a-z]+)*$"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "taken_at",
        "convention",
        "promotions",
        "votes",
        "dictionary"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "taken_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
        },
        "convention": {
          "type": "string",
          "minLength": 1
        },
        "promotions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "anagrams",
            "listed",
            "total",
            "left_out"
          ],
          "properties": {
            "anagrams": {
              "type": "integer",
              "minimum": 0
            },
            "listed": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "left_out": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unchecked",
                "blocked"
              ],
              "properties": {
                "unchecked": {
                  "type": "integer",
                  "minimum": 0
                },
                "blocked": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "votes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hits",
            "total"
          ],
          "properties": {
            "hits": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "dictionary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo",
            "rev"
          ],
          "properties": {
            "repo": {
              "type": "string"
            },
            "rev": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
