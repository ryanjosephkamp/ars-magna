{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ars-magna.pages.dev/schema/hit.schema.json",
  "title": "Hit",
  "description": "One anagram worth keeping. One line of data/hits.jsonl and one row of the published dataset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "input", "category", "words", "display", "letters", "prefilter_score",
    "judge", "added", "dictionary", "tier", "tags", "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "The candidate id, a colon, and the words sorted and joined with '-'. Two hits with the same words on the same input are the same hit.",
      "pattern": "^[a-z]+:(people|companies|products|titles|places|phrases):[a-z]+(-[a-z]+)*$"
    },
    "input": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["people", "companies", "products", "titles", "places", "phrases"]
    },
    "words": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z]+$" },
      "description": "The words as a multiset, in the order they read best."
    },
    "display": { "type": "string", "minLength": 1, "description": "The words joined with spaces, in reading order." },
    "letters": { "type": "string", "pattern": "^[a-z]+$", "description": "The sorted letters (alphagram) the input and the words share." },
    "prefilter_score": { "type": "number" },
    "judge": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "rubric_version", "aptness", "grammar", "memorability", "total", "rationale", "judged_at"],
        "properties": {
          "model": { "type": "string", "minLength": 1 },
          "rubric_version": { "type": "string", "pattern": "^v[0-9]+$" },
          "aptness": { "type": "integer", "minimum": 1, "maximum": 5 },
          "grammar": { "type": "integer", "minimum": 1, "maximum": 5 },
          "memorability": { "type": "integer", "minimum": 1, "maximum": 5 },
          "total": { "type": "integer", "minimum": 3, "maximum": 15 },
          "rationale": { "type": "string", "minLength": 1 },
          "judged_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" }
        }
      }
    },
    "submitter": { "type": "string" },
    "added": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "dictionary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "rev"],
      "properties": {
        "repo": { "type": "string" },
        "rev": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "tier": { "type": "string", "enum": ["common", "standard", "full"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "status": {
      "type": "string",
      "enum": ["proposed", "accepted", "featured", "retired"],
      "description": "proposed: passed the judge, awaiting a person. accepted: in the dataset. featured: accepted and worth showing first. retired: was accepted, now withdrawn; kept so the id is never reused."
    }
  }
}
