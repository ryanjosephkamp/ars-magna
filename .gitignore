# dependencies
node_modules/

# build output
dist/
target/
*.tsbuildinfo

# wasm-pack output (generated by `pnpm wasm:build`)
packages/engine/src/wasm/

# large pinned source downloads (content-addressed by HF revision)
.cache/

# Definition shards ARE committed (~18 MB). They are deterministic output of
# pinned sources, and committing them means a deploy needs no 326 MB download
# from Hugging Face — the site does not depend on a third party being up to
# build. Regenerate with `pnpm dict:shards` when a pin moves.

# local env / editor
.env
.env.local
# wrangler's local secrets for `pages dev`, and its local D1 and cache
.dev.vars
apps/web/.wrangler/
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Greatest Hits queue: the raw enumeration and, since settings s2, the
# prefiltered rows are too big to commit; the nightly keeps both as an
# artifact, and the judge inputs are derived. The screen input and scores,
# the screen's and the judge's answers, the rows the screen kept and the
# ingest report are committed. Queues from before s2 keep their committed
# prefiltered.jsonl.
data/queue/*/raw.jsonl
data/queue/*/prefiltered.jsonl
data/queue/*/judge-input-*.md
dataset/

# Built by apps/web/scripts/build-hits.ts from data/hits.jsonl before every dev and build.
apps/web/public/hits.json
apps/web/public/hits/
