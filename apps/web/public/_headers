# Cloudflare Pages response headers.
#
# Pages applies EVERY rule whose pattern matches, in file order, appending each
# one's values. It does not pick the most specific. So two rules that both match
# a path produce `Cache-Control: public, max-age=300, must-revalidate, public,
# max-age=31536000, immutable` — verified against the live deployment — and a
# stray `immutable` in there is not overridden by the earlier max-age.
#
# That is why the artifact rules below are written per extension rather than as
# `/dict/*`: a wildcard would also match manifest.json and quietly make the one
# file that must stay fresh cacheable for a year.

# The manifest is the pointer to the content-hashed artifacts. If it were cached
# hard, a dictionary rebuild would never be picked up — the browser would keep
# asking for filenames that no longer exist.
/dict/manifest.json
  Cache-Control: public, max-age=300, must-revalidate

# Matched by `/defs/*` below as well, which is safe only because that rule has no
# `immutable` and the first max-age is the one that applies. Definition shards
# are all `.json`, so there is no extension to separate them by.
/defs/manifest.json
  Cache-Control: public, max-age=300, must-revalidate

# The pre-compressed artifacts. These are brotli streams on disk, served under
# their own URL rather than negotiated — Pages does not pick between sibling
# files — so the encoding has to be declared here or the browser hands the
# engine raw brotli. The engine checks the decoded length against the manifest
# and falls back to the plain `.bin` if this header ever goes missing.
#
# Without this the dictionary crosses the wire uncompressed: octet-stream is
# not on Cloudflare's on-the-fly compression list, so 2.1 MB instead of 684 KB.
/dict/*.br
  Content-Encoding: br
  Cache-Control: public, max-age=31536000, immutable

# Dictionary artifacts carry a content hash in the filename, so a change is a
# new URL and these can never go stale. Listed by extension so manifest.json
# above keeps its short life — see the note at the top.
/dict/*.bin
  Cache-Control: public, max-age=31536000, immutable

/dict/*.bits
  Cache-Control: public, max-age=31536000, immutable

# Vite's own output is content-hashed too.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Definition shards are *not* content-hashed — they are addressed by word hash,
# so `0.json` keeps its name across rebuilds. Cache them for a day and let
# revalidation pick up a dictionary bump.
/defs/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The service worker must be re-fetched, or a bad one can never be replaced.
/sw.js
  Cache-Control: no-cache

/precache.json
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
